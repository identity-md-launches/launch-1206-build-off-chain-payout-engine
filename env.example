# IMD Money Back payout engine — copy to .env (never commit it) and fill in.
# Amounts marked (IMD) are decimal IMD, e.g. 12.5. Fractions accept "1/3", "0.25" or "25%".

# --- launch -------------------------------------------------------------------------------------
# Path to launch.json (addresses discovered at launch; see launch.example.json and npm run discover).
LAUNCH_JSON=launch.json
# Where indexes, ledgers, snapshots and state live.
DATA_DIR=data

# --- executor -----------------------------------------------------------------------------------
# dry-run (default): computes, writes ledgers, sends nothing. live: sweeps, funds and pays.
EXECUTOR=dry-run
# Private key of the payout wallet (owner of RoundPayout). Only read in live mode, from the
# environment only. Never put it in a file that is committed, logged or copied into data/.
PAYOUT_PRIVATE_KEY=
# Blocks to wait after each tx before treating it as final.
CONFIRMATION_BLOCKS=5
# Give up waiting for a receipt after this many ms.
TX_TIMEOUT_MS=120000
# A drop paying more than this (IMD) is refused and alerted instead of sent.
MAX_ROUND_PAYOUT_QUOTE=1000000
# Failed legs are retried this many times (retryFailed) before writeOffFailed.
MAX_LEG_RETRIES=3
# Funding proof: balance reads on the priority node before a round is deferred to the next tick.
FUNDING_PROOF_ATTEMPTS=20
FUNDING_PROOF_DELAY_MS=1500
# Creating this file halts every send (default: $DATA_DIR/PAUSE).
PAUSE_FILE=
# Seconds between rounds-app ticks (index, compute, execute).
ROUNDS_TICK_MS=15000

# --- rpc ----------------------------------------------------------------------------------------
# Comma-separated Robinhood Chain (4663) endpoints, used round-robin with backoff.
RPC_URLS=https://rpc.mainnet.chain.robinhood.com
# Optional endpoint dedicated to eth_getLogs.
RPC_LOGS_URL=
# Optional endpoint pinned for every read and send inside a payout round (funding proof, isPaid).
RPC_PRIORITY_URL=
# Poll interval for receipts (RH has ~0.1 s blocks).
VIEM_POLL_MS=750
# Index up to the LOWEST head across endpoints minus this many blocks.
FOLLOW_MARGIN=20
# Block spacing of anchor headers used to interpolate timestamps when a node omits blockTimestamp.
ANCHOR_SPACING=100
# Blocks per eth_getLogs request (refused ranges are bisected automatically).
LOG_CHUNK=50000
RPC_MAX_RETRIES=6
RPC_BACKOFF_MS=500
# Minimum ms between two requests to the same endpoint (public nodes rate-limit with HTTP 403/429).
RPC_MIN_INTERVAL_MS=100

# --- product rules (defaults are the locked rules; change only with a published rule change) -----
EPOCH_SECONDS=900
TWAP_SECONDS=180
# Sweeps / distributor receipts up to boundary + this many seconds count toward that drop.
CLAIM_GRACE_SECONDS=120
# Minimum qualifying buys (IMD) to be eligible.
MIN_BUY_IMD=0
# Legs smaller than this (IMD) are skipped; the amount rolls forward.
MIN_PAYOUT_IMD=0
# Per-drop cap as a fraction of the wallet's current loss.
MAX_ROUND_RATIO=1/3
# Cumulative cap as a fraction of the loss (1 = made whole).
MAX_PAYOUT_RATIO=1
# weight = loss^a * pct^b
WEIGHT_LOSS_EXP=1
WEIGHT_PCT_EXP=0
# Share of each distributor receipt booked to the pouch (rest is team share, never paid).
DISTRIBUTOR_POUCH_SHARE=1/4
MAX_RECIPIENTS_PER_TX=200
# Extra excluded addresses, comma-separated.
EXCLUDE_ADDRESSES=

# --- ops ----------------------------------------------------------------------------------------
# Fraction of each new pouch kept for operations (default 0).
OPS_SKIM_FRACTION=0
# One-time DEX reserve taken from the pot (IMD, default 0).
DEX_RESERVE_QUOTE=0

# --- data / api / alerts ------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8787
# Snapshot and price refresh interval.
PRICE_INTERVAL_MS=60000
# Telegram alerts (paid / failed / stalled / heartbeat). Empty = stdout only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEARTBEAT_MINUTES=60
# Alert when the rounds app has made no progress for this long.
STALL_MINUTES=30
